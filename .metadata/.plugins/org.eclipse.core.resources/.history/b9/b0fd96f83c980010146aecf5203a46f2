  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI5_Init();
  MX_RNG_Init();
  MX_TIM1_Init();
  MX_USART3_UART_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */
//  sprintf(str, "12123");

  cmdBuffer[0] = 0x03;
  cmdBuffer[1] = 0x00;
  cmdBuffer[2] = 0x04;

  ILI9341_Init(); // initial driver setup to drive ili9341
  ILI9341_Set_Rotation(SCREEN_HORIZONTAL_1);

  ILI9341_Fill_Screen(WHITE);
  ILI9341_Draw_Filled_Circle(40, 100, 20, RED);
  ILI9341_Draw_Filled_Circle(40, 150, 20, GREEN);
  ILI9341_Draw_Filled_Circle(40, 200, 20, BLUE);

  HAL_Delay(1000);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
//	  sprintf(str, "Temperature = %4.1f\tHumidity = %4.1f\n\r", t, h);
//	  while(__HAL_UART_GET_FLAG(&huart3, UART_FLAG_TC) == RESET){}
//	  HAL_UART_Transmit(&huart3, (uint8_t*)str, strlen(str), 200);

	  HAL_I2C_Master_Transmit(&hi2c1, 0x5c<<1, cmdBuffer, 3, 200);

	  HAL_I2C_Master_Transmit(&hi2c1, 0x5c<<1, cmdBuffer, 3, 200);

	  HAL_Delay(1);

	  HAL_I2C_Master_Receive(&hi2c1, 0x5c<<1, dataBuffer, 8, 200);

	  uint8_t Rcrc = dataBuffer[7] << 8;
	  Rcrc += dataBuffer[6];

	  if (Rcrc == CRC16_2(dataBuffer, 6)) {
		  uint16_t temperature = ((dataBuffer[4] & 0x7F) << 8) + dataBuffer[5];
		  t = temperature / 10.0;
		  t = (((dataBuffer[4] & 0x80) >> 7) == 1) ? (t * (-1)) : t;

		  uint16_t humidity = (dataBuffer[2] << 8) + dataBuffer[3];
		  h = humidity / 10.0;
	  }

	  	uint8_t tempBuffer[8];
	  	uint8_t humidBuffer[8];

		sprintf(tempBuffer, "%4.1f C", t);
		ILI9341_Draw_Text(tempBuffer, 60, 40, BLACK, 2, WHITE);

		sprintf(humidBuffer, "%4.1f %%RH", h);
		ILI9341_Draw_Text(humidBuffer, 170, 40, BLACK, 2, WHITE);

		  if (TP_Touchpad_Pressed()){
			  uint16_t x_pos = 0;
			  uint16_t y_pos = 0;
			  uint16_t position[2];

			  if (TP_Read_Coordinates(position) == TOUCHPAD_DATA_OK) {
				  x_pos = position[0];
				  y_pos = position[1];

				  //กดปุ่มแดง เหลือง
				  if((x_pos >= 120 && x_pos <= 170) && (y_pos >= 80 && y_pos <= 120)){
					  redSaturation += 0.1;
					  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_14);
				  }

				  //กดปุ่มเขียว
				  if((x_pos >= 80 && x_pos <= 110) && (y_pos >= 80 && y_pos <= 120)){
					  greenSaturation += 0.1;
					  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);
				  }

				  //กดปุ่มน้ำเงิน
				  if((x_pos >= 30 && x_pos <= 70) && (y_pos >= 80 && y_pos <= 120)){
					  blueSaturation += 0.1;
					  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_7);
				  }


			  }
		  }

		  redSaturation += 0.1;
		  blueSaturation += 0.1;

		  if (redSaturation > 1.00) {redSaturation = 0;}
		  if (greenSaturation > 1.00) {greenSaturation = 0;}
		  if (blueSaturation > 1.00) {blueSaturation = 0;}

		  mixColor();
		  ILI9341_Draw_Filled_Circle(140, 45, 25, mixedColor);

		  sprintf(str, "%d%%", (int)(redSaturation * 100));
		  ILI9341_Draw_Text(str, 180, 45, BLACK, 2, WHITE);

		  ILI9341_Draw_Rectangle(80, 85, 120, 30, LIGHT_RED);
		  ILI9341_Draw_Rectangle(80, 85, (uint16_t)(120 * redSaturation), 30, RED);
		  ILI9341_Draw_Rectangle(80, 135, 120, 30, LIGHT_GREEN);
		  ILI9341_Draw_Rectangle(80, 135, (uint16_t)(120 * greenSaturation), 30, GREEN);
		  ILI9341_Draw_Rectangle(80, 185, 120, 30, LIGHT_BLUE);
		  ILI9341_Draw_Rectangle(80, 185, (uint16_t)(120 * blueSaturation), 30, BLUE);
		  HAL_Delay(300);

		  sprintf(redBuffer, "%d%%", (int)(redSaturation * 100));
		  sprintf(greenBuffer, "%d%%", (int)(greenSaturation * 100));
		  sprintf(blueBuffer, "%d%%", (int)(blueSaturation * 100));

		  ILI9341_Draw_Rectangle(215, 85, 60, 20, WHITE); // เคลียร์พื้นหลัง
		  ILI9341_Draw_Text(redBuffer, 215, 85, BLACK, 2, WHITE);
		  ILI9341_Draw_Text(greenBuffer, 215, 135, BLACK, 2, WHITE);
		  ILI9341_Draw_Text(blueBuffer, 215, 185, BLACK, 2, WHITE);

		  HAL_Delay(1000);
  }

  /* USER CODE END 3 */
}

