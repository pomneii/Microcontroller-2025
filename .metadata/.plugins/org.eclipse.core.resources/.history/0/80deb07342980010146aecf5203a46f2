void mixColor() {
  uint8_t redValue = 0b11111;
  uint8_t greenValue = 0b111111;
  uint8_t blueValue = 0b11111;

  redValue = (uint8_t)(redValue * redSaturation);
  greenValue = (uint8_t)(greenValue * greenSaturation);
  blueValue = (uint8_t)(blueValue * blueSaturation);

  mixedColor = (uint16_t)(blueValue);
  mixedColor |= (greenValue << 5);
  mixedColor |= (redValue << 11);
}
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
uint16_t CRC16_2(uint8_t *ptr, uint8_t length){

	uint16_t crc = 0xFFFF;
	uint8_t  s   = 0x00;

	while(length--){
		crc ^= *ptr++;
		for(s = 0; s < 8; s++){
			if((crc & 0x01) != 0){
				crc >>= 1;
				crc ^= 0xA001;
			} else crc >>= 1;
		}
	}
	return crc;
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* Enable the CPU Cache */

  /* Enable I-Cache---------------------------------------------------------*/
  SCB_EnableICache();

  /* Enable D-Cache---------------------------------------------------------*/
  SCB_EnableDCache();

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI5_Init();
  MX_RNG_Init();
  MX_TIM1_Init();
//  MX_USART3_UART_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */
//  sprintf(str, "12123");

  ILI9341_Init(); // initial driver setup to drive ili9341
  ILI9341_Set_Rotation(SCREEN_HORIZONTAL_1);

  ILI9341_Fill_Screen(WHITE);
  ILI9341_Draw_Filled_Circle(40, 100, 20, RED);
  ILI9341_Draw_Filled_Circle(40, 150, 20, GREEN);
  ILI9341_Draw_Filled_Circle(40, 200, 20, BLUE);

  HAL_Delay(1000);

  uint8_t cmdBuffer[3] = {0x03, 0x00, 0x04};
  uint8_t dataBuffer[8];
  HAL_StatusTypeDef txStatus, rxStatus;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  // ส่งคำสั่งอ่าน sensor
	  txStatus = HAL_I2C_Master_Transmit(&hi2c1, 0x5C<<1, cmdBuffer, 3, 500);
	  if(txStatus != HAL_OK){
	      // ส่งค่า error ผ่าน UART หรือ toggle LED
	      char msg[50];
	      sprintf(msg, "I2C Transmit Fail: %d\r\n", txStatus);
	      HAL_UART_Transmit(&huart3, (uint8_t*)msg, strlen(msg), 200);
	      HAL_Delay(1000);
	  } else {
	      // เพิ่ม delay ให้ sensor พร้อมส่งข้อมูล
	      HAL_Delay(10); // sensor อาจต้องเวลา 10-20ms

	      // อ่านค่า sensor
	      rxStatus = HAL_I2C_Master_Receive(&hi2c1, 0x5C<<1, dataBuffer, 8, 500);
	      if(rxStatus != HAL_OK){
	          char msg[50];
	          sprintf(msg, "I2C Receive Fail: %d\r\n", rxStatus);
	          HAL_UART_Transmit(&huart3, (uint8_t*)msg, strlen(msg), 200);
	          HAL_Delay(1000);
	      } else {
	          // ตรวจสอบ CRC
	          uint16_t Rcrc = (dataBuffer[7] << 8) | dataBuffer[6];
	          if(Rcrc == CRC16_2(dataBuffer, 6)){
	              int16_t tempRaw = ((dataBuffer[4] & 0x7F) << 8) | dataBuffer[5];
	              t = tempRaw / 10.0;
	              if(dataBuffer[4] & 0x80) t = -t;

	              uint16_t humRaw = (dataBuffer[2] << 8) | dataBuffer[3];
	              h = humRaw / 10.0;

	              // แสดงค่า temperature/humidity
	              char buf[50];
	              sprintf(buf, "Temp: %.1fC, Hum: %.1f%%\r\n", t, h);
	              HAL_UART_Transmit(&huart3, (uint8_t*)buf, strlen(buf), 200);
	          } else {
	              HAL_UART_Transmit(&huart3, (uint8_t*)"CRC Error\r\n", 11, 200);
	          }
	      }
	  }

	          // Touchpad check
			  if(TP_Touchpad_Pressed()){
				  uint16_t pos[2];
				  if(TP_Read_Coordinates(pos) == TOUCHPAD_DATA_OK){
					  uint16_t x = pos[0];
					  uint16_t y = pos[1];

					  if((x >= 120 && x <= 170) && (y >= 80 && y <= 120)) {
						  redSaturation += 0.1;
						  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_14);
					  }
					  if((x >= 80 && x <= 110) && (y >= 80 && y <= 120)) {
						  greenSaturation += 0.1;
						  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_0);
					  }
					  if((x >= 30 && x <= 70) && (y >= 80 && y <= 120)) {
						  blueSaturation += 0.1;
						  HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_7);
					  }
				  }
			  }

			  // Limit saturation
			  if(redSaturation > 1.0) redSaturation = 0;
			  if(greenSaturation > 1.0) greenSaturation = 0;
			  if(blueSaturation > 1.0) blueSaturation = 0;

			  // Draw mixed color circle
			  mixColor();
			  ILI9341_Draw_Filled_Circle(140, 45, 25, mixedColor);

			  // Draw RGB bars
			  ILI9341_Draw_Rectangle(80, 85, 120, 30, LIGHT_RED);
			  ILI9341_Draw_Rectangle(80, 85, (uint16_t)(120 * redSaturation), 30, RED);
			  ILI9341_Draw_Rectangle(80, 135, 120, 30, LIGHT_GREEN);
			  ILI9341_Draw_Rectangle(80, 135, (uint16_t)(120 * greenSaturation), 30, GREEN);
			  ILI9341_Draw_Rectangle(80, 185, 120, 30, LIGHT_BLUE);
			  ILI9341_Draw_Rectangle(80, 185, (uint16_t)(120 * blueSaturation), 30, BLUE);

			  // Draw RGB % text
			  sprintf(redBuffer, "%d%%", (int)(redSaturation * 100));
			  sprintf(greenBuffer, "%d%%", (int)(greenSaturation * 100));
			  sprintf(blueBuffer, "%d%%", (int)(blueSaturation * 100));
			  ILI9341_Draw_Rectangle(215, 85, 60, 20, WHITE);
			  ILI9341_Draw_Text(redBuffer, 215, 85, BLACK, 2, WHITE);
			  ILI9341_Draw_Text(greenBuffer, 215, 135, BLACK, 2, WHITE);
			  ILI9341_Draw_Text(blueBuffer, 215, 185, BLACK, 2, WHITE);

			  HAL_Delay(300);
  }

  /* USER CODE END 3 */
}

