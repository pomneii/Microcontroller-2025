void send_uart(uint8_t r, uint8_t g, uint8_t b) {

    char buffer[100];
    int len = sprintf(buffer, "Duty Cycle\r\nR : %d%% \r\nG : %d%% \r\nB : %d%% \r\n\n", r, g, b);  // แปลงเป็น string
    while (__HAL_UART_GET_FLAG(&huart3, UART_FLAG_TC) == RESET) {}
    HAL_UART_Transmit(&huart3, (uint8_t*)buffer, len, 1000);



}
void receive_uart() {
	char color;
	while (__HAL_UART_GET_FLAG(&huart3, UART_FLAG_RXNE) == RESET) {}
	HAL_UART_Receive(&huart3, (char*) &color, 1, 1000);

	check_color(color);
	send_uart(duty_red, duty_green, duty_blue);

	uint32_t arr = __HAL_TIM_GET_AUTORELOAD(&htim2);
	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, ((arr + 1) * duty_red) / 100);
	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_3, ((arr + 1) * duty_green) / 100);
	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_4, ((arr + 1) * duty_blue) / 100);

}

void check_color(char color) {
	if (color == 'r') {
	  duty_red += 20;
	  if (duty_red > 100) duty_red = 0;
	}
	else if (color == 'g'){
	  duty_green += 20;
	  if (duty_green > 100) duty_green = 0;
	}
	else if (color == 'b') {
	  duty_blue += 20;
	  if (duty_blue > 100) duty_blue = 0;
	}
}
