void send_uart(uint8_t r, uint8_t g, uint8_t b) {
    char buffer[150];
    int len = sprintf(buffer, "Duty Set - R:%d%%, G:%d%%, B:%d%% | PWM: R=%d, G=%d, B=%d | Measured: %d%%\r\n",
                     r, g, b, pwm_red, pwm_green, pwm_blue, measured_duty_red);
    while (__HAL_UART_GET_FLAG(&huart3, UART_FLAG_TC) == RESET) {}
    HAL_UART_Transmit(&huart3, (uint8_t*)buffer, len, 1000);
}

void receive_uart() {
    char color;
    while (__HAL_UART_GET_FLAG(&huart3, UART_FLAG_RXNE) == RESET) {}
    HAL_UART_Receive(&huart3, (char*) &color, 1, 1000);

    check_color(color);
    send_uart(duty_red, duty_green, duty_blue);
}

void check_color(char color) {
    if (color == 'r') {
      duty_red += 20;
      if (duty_red > 100) duty_red = 0;
    }
    else if (color == 'g'){
      duty_green += 20;
      if (duty_green > 100) duty_green = 0;
    }
    else if (color == 'b') {
      duty_blue += 20;
      if (duty_blue > 100) duty_blue = 0;
    }
}

// ฟังก์ชันวัด duty cycle โดยการสุ่ม (ใช้สำหรับแสดงค่าเปอร์เซ็นต์)
uint8_t measure_duty_cycle(GPIO_TypeDef* GPIOx, uint16_t GPIO_Pin) {
    uint32_t high_count = 0;
    uint32_t total_samples = 500;  // ลดจำนวนตัวอย่างเพื่อความเร็ว

    for (uint32_t i = 0; i < total_samples; i++) {
        if (HAL_GPIO_ReadPin(GPIOx, GPIO_Pin) == GPIO_PIN_SET) {
            high_count++;
        }
        // หน่วงเวลาเล็กน้อย
        for (volatile int j = 0; j < 3; j++);
    }

    return (high_count * 100) / total_samples;
}
