volatile uint8_t duty_red = 0;
volatile uint8_t duty_green = 0;
volatile uint8_t duty_blue = 0;

// ตัวแปรสำหรับ plot ใน STM32Monitor (ค่า 0-1 สำหรับกราฟ PWM)
volatile uint8_t pwm_red = 0;    // จะแสดงค่า 0 หรือ 1
volatile uint8_t pwm_green = 0;
volatile uint8_t pwm_blue = 0;

// ตัวแปรสำหรับแสดงค่า duty cycle ที่วัดได้ (ถ้าต้องการดู)
volatile uint8_t measured_duty_red = 0;
/* USER CODE END PV */

